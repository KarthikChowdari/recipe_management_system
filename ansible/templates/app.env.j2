# {{ ansible_managed }}
# Environment for the {{ app_name }} container ({{ app_environment }})
SERVER_PORT={{ app_container_port }}
JAVA_OPTS={{ app_java_opts }}
SEED_DATA={{ app_seed_data }}
APP_AUTHOR_PASSWORD={{ app_author_password }}
APP_REVIEWER_PASSWORD={{ app_reviewer_password }}
APP_ADMIN_PASSWORD={{ app_admin_password }}
{% if app_spring_profile %}
SPRING_PROFILES_ACTIVE={{ app_spring_profile }}
{% endif %}
{% if app_db_url %}
DB_URL={{ app_db_url }}
DB_USERNAME={{ app_db_username }}
DB_PASSWORD={{ app_db_password }}
{% endif %}
{% for key, value in app_extra_env.items() %}
{{ key }}={{ value }}
{% endfor %}
